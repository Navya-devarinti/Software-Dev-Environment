# Local development configuration for the PNW Information Chatbot.
#
# Copy this file to .env only when a local configuration file is needed.
# Values here are intentionally local and non-sensitive: do not add API keys,
# passwords, connection strings with credentials, or student-specific data.

# Store the reviewed public-source corpus in PostgreSQL with pgvector.
DATABASE_URL=postgresql+psycopg://pnw:pnw@localhost:5432/pnw_information_chatbot

# Bind the local development server to this machine only.
APP_HOST=127.0.0.1
APP_PORT=8000
